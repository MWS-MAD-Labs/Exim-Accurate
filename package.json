{
  "name": "exim-accurate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run lint && npm run type-check",
    "test:unit": "tsx --test lib/*.test.ts lib/accurate/*.test.ts lib/import/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "db:resolve:borrowing-history": "prisma migrate resolve --applied 20260216105500_add_borrowing_feature && prisma migrate resolve --applied 20260420090000_merge_borrowable_items_across_credentials",
    "pretype-check": "prisma generate",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-user.ts",
    "db:map-central-organization": "tsx scripts/map-central-organization.ts",
    "pos:walkthrough": "tsx --env-file=.env scripts/pos-walkthrough.ts",
    "badge:check": "tsx --env-file=.env scripts/badge-check.ts check",
    "badge:issue": "tsx --env-file=.env scripts/badge-check.ts issue",
    "staff:audit": "tsx --env-file=.env scripts/staff-audit.ts",
    "users:sync": "tsx --env-file=.env scripts/sync-users.ts",
    "permissions:sync": "tsx --env-file=.env scripts/sync-permissions.ts sync",
    "permissions:check": "tsx --env-file=.env scripts/sync-permissions.ts check"
  },
  "dependencies": {
    "@mantine/core": "^7.15.2",
    "@mantine/dates": "^7.15.2",
    "@mantine/hooks": "^7.15.2",
    "@mantine/modals": "^7.15.2",
    "@mantine/notifications": "^7.15.2",
    "@prisma/client": "^6.19.0",
    "@tabler/icons-react": "^3.23.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "mws-central-auth": "github:MWS-MAD-Labs/mws-central-auth#v0.7.0",
    "next": "16.3.0",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "prisma": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
