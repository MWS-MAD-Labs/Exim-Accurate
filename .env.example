# Database. This one is for your machine: localhost and the port compose.local.yaml publishes.
# In a Komodo stack leave DATABASE_URL out, so the compose file uses its own Postgres:
# postgresql://postgres:password@postgres:5432/exim_accurate. That Postgres is not published on the host,
# so a staging stack and a production stack on one host do not collide on the database.
DATABASE_URL="postgresql://postgres:password@localhost:5433/exim_accurate?schema=public"

# The password of the Postgres inside a stack, also used by the default DATABASE_URL of the stack. Make one with
# openssl rand -hex 24 (hex needs no encoding in a URL). Postgres reads it only when its volume is first made, so
# set it before the first deploy of a new stack. POSTGRES_USER and POSTGRES_DB can be set the same way.
POSTGRES_PASSWORD=

# The public address of Exima, https in staging and production, without a port. Exima builds redirect addresses from it.
# The tunnel or gateway points its hostname at the port below.
NEXTAUTH_URL="http://localhost:5758"
# The port Exima is published on at the host. The app itself always listens on 5758 inside its container.
# Staging next to production on one host needs another value, for example 5759.
EXIMA_HOST_PORT=5758

# MWS Hub shared session. Exima has no sign-in or sign-out of its own: it reads the Hub's session cookie.
HUB_BASE_URL="https://app.mws.web.id"
HUB_SSO_APP_ID="exima"

# MWS Data Center internal API. Use an Exima client scoped to employees:read.
CENTRAL_API_BASE_URL="https://db.mws.web.id/api/internal"
CENTRAL_API_TOKEN="token-prefix.secret"
# The organization of Exima in Central. The local organization is mapped to it on the first sign-in.
CENTRAL_ORGANIZATION_ID="org_exima_xxxxxxxxxxxxxxxxxxxx"

# Accurate App (for token generation)
ACCURATE_APP_KEY="your-accurate-app-key"
ACCURATE_SIGNATURE_SECRET="your-accurate-signature-secret"
ACCURATE_CLIENT_ID="your-accurate-client-id"
ACCURATE_CLIENT_SECRET="your-accurate-client-secret"
# Where Accurate sends a person back. The same address must be registered in the Accurate developer application.
# Locally it is the port Exima runs on, for example http://localhost:3001/accurate/callback
ACCURATE_REDIRECT_URI="https://exima.mws.web.id/accurate/callback"

# Node Environment
NODE_ENV="development"

# Cron Job Security
CRON_SECRET="your-cron-secret-here"

# How long Central's answer about what a person may do is kept (seconds).
EXIMA_CENTRAL_ACCESS_CACHE_SECONDS=30
# Accounts that always get in, comma separated.
EXIMA_CENTRAL_ACCESS_BYPASS_EMAILS=

# Signs staff badges (16 characters or more, keep it secret). Changing it cancels every badge.
EXIMA_BADGE_SECRET=
# Cards printed with the email on them keep working while this is on. Turn it off once everyone
# uses the signed badge from My Badge or a printed sheet.
EXIMA_LEGACY_EMAIL_BADGES=on

# How often the server checks Central for changed people, in seconds (15 or more, 0 turns it off).
EXIMA_AUTO_SYNC_SECONDS=60

# Sends the permission list of this version to Central when the server starts (on, or off).
EXIMA_PERMISSION_SYNC=on

# Email for allowance notifications and sale receipts, sent through Gmail. 465 is the port of the mail server, not of Exima.
# Staging should use its own mailbox, or leave the user and password empty so it sends nothing to real people.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Exima Notifications <no-reply@example.org>"
