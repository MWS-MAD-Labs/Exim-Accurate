// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())

  accurateCredentials AccurateCredentials[]
  exportJobs          ExportJob[]
  importJobs          ImportJob[]
  kioskSyncData       KioskSyncData[]
  borrowingSessions   BorrowingSession[]
  borrowingActivities BorrowingActivity[]
  posSales            PosSale[]
  posReservations     PosReservation[]
  posSettings         PosSettings[]
  posAllocations      PosStockAllocation[]
}

model AccurateCredentials {
  id              String   @id @default(uuid())
  userId          String
  appKey          String
  signatureSecret String
  apiToken        String
  refreshToken    String? // OAuth refresh token for token refresh
  host            String?
  session         String? // Session token from open-db.do
  dbId            Int? // Database ID from Accurate
  disconnectedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessions            CheckoutSession[]
  exportJobs                  ExportJob[]
  importJobs                  ImportJob[]
  borrowingSessions           BorrowingSession[]
  borrowingActivities         BorrowingActivity[]
  posSettings                 PosSettings?
  posSales                    PosSale[]
  posReservations             PosReservation[]
  posAllocations              PosStockAllocation[]
  posProducts                 PosProduct[]
  posAllowancePeriodOverrides PosAllowancePeriodOverride[]
}

// Self Checkout feature - tracks staff checkout sessions
model CheckoutSession {
  id           String    @id @default(uuid())
  staffEmail   String // Email from QR badge scan
  staffName    String? // Parsed from email or badge
  staffDept    String? // Department parsed from email
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("pending") // pending, completed, failed
  errorMessage String?

  items        CheckoutItem[]
  credentialId String
  credential   AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  adjustmentId Int? // ID of created inventory adjustment in Accurate
}

model CheckoutItem {
  id        String          @id @default(uuid())
  sessionId String
  session   CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemCode  String // Scanned barcode/item code
  itemName  String? // Fetched from Accurate
  quantity  Int             @default(1)
  scannedAt DateTime        @default(now())
}

// Cached kiosk statistics - synced daily via cron
model KioskSyncData {
  id             String   @id @default(uuid())
  userId         String
  year           Int
  month          Int // 1-12
  totalCheckouts Int      @default(0)
  uniqueUsers    Int      @default(0)
  topUsers       Json     @default("[]") // [{email, name, count}]
  topItems       Json     @default("[]") // [{itemCode, itemName, totalQuantity}]
  dailyData      Json     @default("[]") // [{date, count}]
  lastSyncAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
}

model ExportJob {
  id           String    @id @default(uuid())
  userId       String
  credentialId String?
  type         String // "inventory_adjustment"
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String // pending, running, done, error
  resultUrl    String?
  errorMessage String?
  format       String?
  recordCount  Int?

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
}

model ImportJob {
  id           String    @id @default(uuid())
  userId       String
  credentialId String?
  type         String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String
  resultUrl    String?
  errorMessage String?
  format       String?
  fileName     String?
  recordCount  Int?
  successCount Int?
  failedCount  Int?

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
}

// Peminjaman (Borrowing) feature - items configured as available for borrowing
model BorrowableItem {
  id String @id @default(uuid())

  itemCode   String // Accurate item code
  itemName   String // Cached from Accurate
  totalStock Int // Reference number (how many we should have)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemCode])
}

// Tracks borrowing/return sessions
model BorrowingSession {
  id           String @id @default(uuid())
  userId       String
  credentialId String

  borrowerEmail String
  borrowerName  String?
  borrowerDept  String?

  type       String    @default("borrow") // borrow, booking
  status     String    @default("active") // active, returned, partial
  startsAt   DateTime  @default(now())
  dueAt      DateTime?
  borrowedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  adjustmentOutId Int? // Accurate adjustment ID for borrow (ADJUSTMENT_OUT)
  adjustmentInId  Int? // Accurate adjustment ID for return (ADJUSTMENT_IN)

  items      BorrowingItem[]
  activities BorrowingActivity[]
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model BorrowingItem {
  id        String           @id @default(uuid())
  sessionId String
  session   BorrowingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  itemCode String // Accurate item code
  itemName String // Cached from Accurate
  quantity Int    @default(1)

  returnedQty Int       @default(0)
  returnedAt  DateTime?
}

model BorrowingActivity {
  id           String  @id @default(uuid())
  userId       String
  credentialId String
  sessionId    String?

  itemCode      String
  itemName      String
  borrowerEmail String
  borrowerName  String?
  borrowerDept  String?

  activityType  String // borrow, booking, return
  quantity      Int       @default(1)
  occurredAt    DateTime  @default(now())
  scheduleStart DateTime?
  scheduleEnd   DateTime?
  details       String?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  session    BorrowingSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([credentialId, occurredAt])
  @@index([credentialId, itemCode, occurredAt])
}

model PosSettings {
  id            String   @id @default(uuid())
  userId        String
  credentialId  String   @unique
  warehouseId   Int
  warehouseName String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Staff allowance: monthly total = allowancePerWorkingDay * count of workingDays in the current month
  allowancePerWorkingDay Decimal  @default(0) @db.Decimal(14, 2)
  workingDays            Int[]    @default([1, 2, 3, 4, 5]) // 0=Sunday .. 6=Saturday
  holidayDates           String[] @default([]) // Date-only values in YYYY-MM-DD format
  allowanceCutoffDay     Int      @default(22) // Normal cycle ends on this day; the next starts the day after
  preorderHoldHours      Int      @default(4) // Hours that staff preorder stock remains locked

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// One-off inclusive allowance periods, used when the normal cutoff cycle changes.
model PosAllowancePeriodOverride {
  id           String   @id @default(uuid())
  credentialId String
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, startsAt, endsAt])
}

// Local POS product catalog is the source of truth for stock and pricing.
// Accurate follows these values through explicit outbound synchronization.
model PosProduct {
  id           String @id @default(uuid())
  credentialId String

  itemCode String
  itemName String
  unit     String?

  buyPrice  Decimal @default(0) @db.Decimal(14, 2)
  sellPrice Decimal @default(0) @db.Decimal(14, 2)

  stock          Int       @default(0)
  isActive       Boolean   @default(true)
  syncStatus     String    @default("pending") // pending, synced, error
  syncError      String?
  accurateItemId Int?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, itemCode])
  @@index([credentialId, isActive])
}

model PosReservation {
  id                 String    @id @default(uuid())
  userId             String
  credentialId       String
  reference          String    @unique
  idempotencyKey     String
  requestFingerprint String
  warehouseId        Int
  warehouseName      String
  staffEmail             String
  staffName              String?
  preferredPaymentMethod String   @default("allowance") // allowance, cash, qris
  status                 String   @default("active") // active, picked_up, cancelled, expired
  expiresAt              DateTime
  pickupAt               DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential AccurateCredentials  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  items      PosReservationItem[]
  sale       PosSale?

  @@unique([userId, idempotencyKey])
  @@index([credentialId, status, expiresAt])
  @@index([userId, createdAt])
}

model PosReservationItem {
  id            String  @id @default(uuid())
  reservationId String
  itemCode      String
  itemName      String
  quantity      Int
  unitPrice     Decimal @db.Decimal(18, 2)
  unitCost      Decimal @db.Decimal(18, 2)

  reservation PosReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, itemCode])
}

model PosSale {
  id                 String    @id @default(uuid())
  userId             String
  credentialId       String
  reservationId      String?   @unique
  idempotencyKey     String
  requestFingerprint String
  warehouseId        Int
  warehouseName      String
  paymentMethod      String
  status             String    @default("pending_sync") // pending_sync, synced (confirmed inventory adjustment), sync_error
  accurateId         Int? // Accurate inventory adjustment ID
  syncError          String?
  createdAt          DateTime  @default(now())
  syncedAt           DateTime?

  // Buyer identification (staff QR badge scan) and allowance payment usage
  buyerType     String  @default("guest") // staff, guest
  staffEmail    String?
  staffName     String?
  allowanceUsed Decimal @default(0) @db.Decimal(14, 2)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential  AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  reservation PosReservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  items       PosSaleItem[]

  @@unique([userId, idempotencyKey])
  @@index([credentialId, createdAt])
  @@index([credentialId, status])
  @@index([credentialId, staffEmail, createdAt])
}

model PosStockAllocation {
  id            String   @id @default(uuid())
  credentialId  String
  warehouseId   Int
  warehouseName String
  itemCode      String
  stockSnapshot Int
  heldQuantity  Int      @default(0)
  soldQuantity  Int      @default(0)
  updatedAt     DateTime @updatedAt

  credential AccurateCredentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([credentialId, warehouseId, itemCode])
  @@index([credentialId, warehouseId])
}

model PosSaleItem {
  id        String  @id @default(uuid())
  saleId    String
  itemCode  String
  itemName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  unitCost  Decimal @db.Decimal(18, 2)

  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, itemCode])
}
